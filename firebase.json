{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "hotellmysteriet",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      ".git/**",
      ".firebase/**",
      "CLAUDE.md",
      "*.backup",
      "Mysterier",
      "Mysterier/**",
      "database.rules.json"
    ],
    "headers": [
      { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] },
      { "source": "**/*.html", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] }
    ]
  }
}
